# Use a random 32+ character value for each secret in production.
ADMIN_ENTRY_TOKEN=replace-with-a-random-entry-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Reverb's app key is a public identifier. Keep the app secret only in Laravel's root .env.
VITE_REVERB_APP_KEY=replace-with-the-root-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_BROADCAST_AUTH_ENDPOINT=/api/broadcasting/auth
