APP_NAME=ShahrazGold
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANEL_USERNAME_shahrazgold
DB_USERNAME=CPANEL_USERNAME_shahrazgold
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
PUBLIC_STORAGE_PATH=/home/CPANEL_USERNAME/public_html/storage

CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

BROADCAST_CONNECTION=log
MAIL_MAILER=log

SHAHRAZGOLD_GOLD18_DIVISOR=4.3318
SHAHRAZGOLD_CALCULATION_SCALE=12
SHAHRAZGOLD_QUANTITY_SCALE=6
SHAHRAZGOLD_PRESENCE_DRIVER=cache
SHAHRAZGOLD_PRESENCE_TTL=90
SHAHRAZGOLD_PRESENCE_PREFIX=presence:user:
