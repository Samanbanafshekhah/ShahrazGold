COMPOSE_PROJECT_NAME=shahrazgold-backend
APP_UID=1000
APP_GID=1000
APP_PORT=8080
POSTGRES_FORWARD_PORT=5433
REDIS_FORWARD_PORT=6380

APP_NAME=ShahrazGold
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
REALTIME_LOG_LEVEL=info
REALTIME_LOG_DAYS=7

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shahrazgold
DB_USERNAME=shahrazgold
# Local development only. Never use this password in production.
DB_PASSWORD=shahrazgold_local_dev_only
DB_SSLMODE=disable

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=shahrazgold_cache_
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

SHAHRAZGOLD_GOLD18_DIVISOR=4.3318
SHAHRAZGOLD_CALCULATION_SCALE=12
SHAHRAZGOLD_QUANTITY_SCALE=6
SHAHRAZGOLD_PRESENCE_TTL=90
SHAHRAZGOLD_PRESENCE_PREFIX=presence:user:
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_API_PROXY_TARGET=http://127.0.0.1:8090

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shahrazgold
REVERB_APP_KEY=replace-with-a-random-public-app-key
REVERB_APP_SECRET=replace-with-a-random-32-character-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:8080
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=shahrazgold-reverb

# The app key is public by design; never expose REVERB_APP_SECRET to Vite.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_BROADCAST_AUTH_ENDPOINT=/api/broadcasting/auth
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Create and approve this template in https://console.kavenegar.com/verification.
# The template must contain %token.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=shahrazgoldverify
KAVENEGAR_SENDER=
KAVENEGAR_TIMEOUT=10
KAVENEGAR_OTP_TTL=300
KAVENEGAR_OTP_RESEND_AFTER=90
KAVENEGAR_OTP_MAX_ATTEMPTS=5
